# ── Core ────────────────────────────────────────────────────────────────────
# "true" = no external services needed: OTP is 000000, users live in
# .demo-data/store.json, vouch gate is bypassed (Phase 3). Never true in prod.
DEMO_MODE=true

# HMAC secret for session/pending JWTs. Required in production.
# Generate: openssl rand -base64 48
AUNTY_SESSION_SECRET=

# Salt for one-way phone-number hashing. Required in production; changing it
# orphans every account, so set it once and guard it.
AUNTY_PHONE_SALT=

# ── Supabase (Phase 1 — leave empty while DEMO_MODE=true) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (Phase 1+) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Daily AI spend cap in INR; past it Aunty serves cached/canned lines (SPEC P8).
AI_DAILY_COST_CAP_INR=500

# ── OTP delivery (Phase 1; MSG91 chosen — DECISIONS.md 2026-07-20) ──────────
MSG91_AUTH_KEY=

# ── Later phases (placeholders; see PROGRESS.md) ────────────────────────────
# RAZORPAY_KEY_ID=            # Phase 6
# RAZORPAY_KEY_SECRET=        # Phase 6
# RAZORPAY_WEBHOOK_SECRET=    # Phase 6
# NEXT_PUBLIC_POSTHOG_KEY=    # Phase 7
# SENTRY_DSN=                 # Phase 7
